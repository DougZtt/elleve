# ==========================================================
# Elleve Studio Dental — site estático (repositório público)
# Objetivo: impedir que segredos, backups e arquivos de
# trabalho cheguem ao repositório por engano.
# Referência: 10/08/2026
# ==========================================================

# ---------- Variáveis de ambiente e segredos ----------
.env
.env.*
# Exceção: template sem valores reais pode ser versionado
!.env.example

# ---------- Chaves e certificados ----------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.asc
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# ---------- Credenciais de serviços ----------
credentials.json
service-account*.json
client_secret*.json
firebase-adminsdk*.json
.npmrc
.netrc
.htpasswd

# ---------- Backups e versões antigas ----------
*.bak
*-old.*
*-backup.*
*.orig
*.tmp
*~

# ---------- Dumps e bancos de dados ----------
*.sql
*.dump
*.sqlite
*.sqlite3
*.db

# ---------- Lixo de sistema operacional ----------
.DS_Store
.DS_Store?
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Editores e IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ---------- Dependências e build ----------
node_modules/
package-lock.json.bak
dist/
build/
.cache/

# ---------- Arquivos-fonte de design (pesados, não servidos) ----------
*.psd
*.ai
*.indd
*.idml
*.sketch
*.fig
*.afdesign
*.afphoto
*.eps
*.cdr
~$*

# ==========================================================
# NÃO IGNORAR — arquivos que o site precisa para funcionar.
# Nenhuma regra acima os bloqueia; a lista existe como
# lembrete se alguém editar este arquivo no futuro:
#
#   index.html          página principal
#   privacidade.html    política de privacidade (LGPD)
#   og-image.jpg        preview de compartilhamento (Open Graph)
#   CNAME               domínio custom no GitHub Pages
#   .nojekyll           desliga o processamento Jekyll, se preciso
#   robots.txt / sitemap.xml
#   favicon.*           ícone do site
#   *.html *.css *.js *.svg *.webp *.jpg *.png *.woff2
#
# Atenção ao separar as imagens em arquivos individuais:
# evite nomes contendo "-old." ou "-backup." (ex.:
# "logo-old.svg" seria ignorado silenciosamente).
#
# Lembrete: .gitignore só afeta arquivos NÃO rastreados.
# Arquivo já commitado continua no repositório e no
# histórico mesmo que passe a casar com uma regra aqui.
# ==========================================================
